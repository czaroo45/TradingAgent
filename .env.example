# Exchange public market data; no credentials required
TRADINGAGENT_EXCHANGE=binance
TRADINGAGENT_DATA_SOURCE=ccxt
TRADINGAGENT_SYMBOLS=BTC/USDT,ETH/USDT,XRP/USDT,SOL/USDT
TRADINGAGENT_TIMEFRAMES=5m,15m,1h,4h,1d
TRADINGAGENT_LIMIT=300
TRADINGAGENT_TIMEOUT_MS=15000
TRADINGAGENT_MAX_CONCURRENCY=1
TRADINGAGENT_MARKET_CACHE_SECONDS=5
# Public ticker-snapshot fallback interval (1..300 seconds); it does not deliver every trade.
TRADINGAGENT_MARKET_REST_POLL_SECONDS=5
TRADINGAGENT_DISPLAY_TIMEZONE=Europe/Warsaw
TRADINGAGENT_DB_PATH=data/market.sqlite3
TRADINGAGENT_MODE=analysis
TRADINGAGENT_PAPER_INITIAL_CAPITAL=10000
TRADINGAGENT_PAPER_QUOTE_CURRENCY=USDT
TRADINGAGENT_PAPER_ACCOUNT_ID=default
TRADINGAGENT_PAPER_SPREAD_BPS=2
TRADINGAGENT_PAPER_SHORT_TRADE_WINDOW_MINUTES=0
# Paper execution worker is opt-in, simulation-only, and requires exchange amount precision.
TRADINGAGENT_PAPER_AUTO_ENABLED=false
# For paper auto-run on multiple symbols, set every symbol's lot step separately,
# format: BTC/USDT=<step-from-market-metadata>,ETH/USDT=<step>,...
TRADINGAGENT_PAPER_AMOUNT_STEPS=
# Legacy scalar is accepted only when TRADINGAGENT_SYMBOLS contains one market.
TRADINGAGENT_PAPER_AMOUNT_STEP=0
TRADINGAGENT_STRATEGY=baseline
TRADINGAGENT_ENABLED_STRATEGIES=trend_following,pullback,breakout_retest,momentum
TRADINGAGENT_STRATEGY_AGGRESSIVE_MODE=false
TRADINGAGENT_STRATEGY_ENTRY_TIMEFRAME=15m
TRADINGAGENT_STRATEGY_HIGHER_TIMEFRAME=4h
TRADINGAGENT_STRATEGY_MIN_NET_RR=1.5
TRADINGAGENT_STRATEGY_MIN_SCORE=60
# Weight order: trend, structure, momentum, volume, timeframe, risk/reward, data, strategy rules
TRADINGAGENT_SCORE_WEIGHTS=1,1,1,0.75,1,1,1,1
TRADINGAGENT_FEE_BPS=10
TRADINGAGENT_SLIPPAGE_BPS=5
TRADINGAGENT_COST_ESTIMATE_NOTIONAL=1000
TRADINGAGENT_MAX_SPREAD_BPS=20
TRADINGAGENT_MAX_RISK_PER_TRADE=0.01
# Demonstration limits only; these values do not guarantee safety or profit.
# Equity/cost/correlation limits below are policy examples, not safe defaults for every account.
TRADINGAGENT_MAX_TOTAL_EXPOSURE=0.50
TRADINGAGENT_MAX_ASSET_EXPOSURE=0.20
TRADINGAGENT_MAX_CORRELATED_EXPOSURE=0.30
TRADINGAGENT_CORRELATED_ASSET_GROUPS=BTC+ETH+XRP+SOL
TRADINGAGENT_MAX_DAILY_LOSS=0.03
TRADINGAGENT_MAX_DRAWDOWN=0.15
TRADINGAGENT_MAX_TRADES_PER_DAY=10
TRADINGAGENT_MIN_RISK_REWARD=1.5
TRADINGAGENT_MAX_TRANSACTION_COST_BPS=50
TRADINGAGENT_MAX_MARKET_DATA_AGE_MS=120000
TRADINGAGENT_TELEGRAM_ENABLED=false
TRADINGAGENT_TELEGRAM_BOT_TOKEN=
TRADINGAGENT_TELEGRAM_CHAT_ID=
TRADINGAGENT_TELEGRAM_TIMEOUT_SECONDS=8
# Optional bearer token for API/dashboard; required when binding beyond localhost.
TRADINGAGENT_API_TOKEN=
TRADINGAGENT_API_SYNC_ENABLED=true
TRADINGAGENT_API_SYNC_SECONDS=60
# Optional LLM explanation. Disabled by default; requires an OpenAI-compatible HTTPS endpoint.
TRADINGAGENT_LLM_ENABLED=false
TRADINGAGENT_LLM_ENDPOINT=
TRADINGAGENT_LLM_MODEL=
TRADINGAGENT_LLM_API_KEY=
TRADINGAGENT_LLM_TIMEOUT_SECONDS=10
TRADINGAGENT_LLM_MAX_INPUT_CHARS=12000
TRADINGAGENT_LLM_MAX_OUTPUT_TOKENS=500
TRADINGAGENT_LLM_MAX_COST_PER_CALL=0.02
# Set these from the selected provider's current pricing; zero disables priced-call estimates.
TRADINGAGENT_LLM_INPUT_COST_PER_1K=0
TRADINGAGENT_LLM_OUTPUT_COST_PER_1K=0
